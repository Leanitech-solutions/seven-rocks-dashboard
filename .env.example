# Database (Neon Postgres)
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/neondb?sslmode=require"

# Cloudinary (Image & Document Storage)
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# Nodemailer / Email Configuration (Google App Password)
# 1. Generate an App Password in your Google Account Security settings:
#    https://myaccount.google.com/apppasswords
# 2. Set your Google Email and the 16-character App Password below:
GOOGLE_EMAIL="your-email@gmail.com"
GOOGLE_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# Optional SMTP Settings (if using custom SMTP provider instead of Gmail)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="user@example.com"
# SMTP_PASS="password"
# SMTP_FROM='"Seven Rocks Co-Living" <no-reply@sevenrocks.com>'

# AI & Additional Services
GEMINI_API_KEY=""
APP_URL="http://localhost:3000"
STRIPE_SECRET_KEY=""
